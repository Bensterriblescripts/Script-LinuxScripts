#!/usr/bin/env fish

set -l inside false
set -l raw_directory ""

function keep_terminal_open
    set -l exit_status "$argv[1]"
    printf '\nTerminal kept open for inspection. Press Ctrl-C to close it.\n' >&2
    while true
        /usr/bin/fish -i -C 'function close_terminal --on-signal INT; exit 130; end'
        set -l terminal_status $status
        if test $terminal_status -eq 130
            exit $exit_status
        else if test $terminal_status -ne 0
            printf 'Run Codex Quick Failed: keeping terminal open\nError: fish exited with status %s.\n' "$terminal_status" >&2
            exit $exit_status
        end
    end
end

if test (count $argv) -eq 2; and test "$argv[1]" = --inside
    set inside true
    set raw_directory "$argv[2]"
else if test (count $argv) -eq 1
    set raw_directory "$argv[1]"
else
    printf 'Run Codex Quick Failed: argument validation\nError: expected exactly one target directory, or --inside followed by exactly one target directory.\n' >&2
    if type -q kdialog
        kdialog --title "Run Codex Quick Failed" --error "Dolphin did not provide a target directory."
    end
    if $inside
        keep_terminal_open 2
    end
    exit 2
end

if test -z "$raw_directory"
    printf 'Run Codex Quick Failed: target directory input\nError: Dolphin did not provide a target directory.\n' >&2
    if type -q kdialog
        kdialog --title "Run Codex Quick Failed" --error "Dolphin did not provide a target directory."
    end
    if $inside
        keep_terminal_open 1
    end
    exit 1
end

for dependency in realpath mktemp timeout jq
    if not type -q "$dependency"
        printf 'Run Codex Quick Failed: dependency validation\nError: missing dependency: %s\n' "$dependency" >&2
        if type -q kdialog
            kdialog --title "Run Codex Quick Failed" --error "Missing dependency: $dependency"
        end
        if $inside
            keep_terminal_open 127
        end
        exit 127
    end
end
if not test -x /home/ben/.local/bin/codex
    printf 'Run Codex Quick Failed: Codex executable validation\nError: /home/ben/.local/bin/codex is not executable.\n' >&2
    if type -q kdialog
        kdialog --title "Run Codex Quick Failed" --error "/home/ben/.local/bin/codex is not executable."
    end
    if $inside
        keep_terminal_open 127
    end
    exit 127
end

set -l directory (realpath -e -- "$raw_directory" 2>&1)
set -l directory_status $status
if test $directory_status -ne 0; or test (count $directory) -ne 1; or not test -d "$directory"; or not test -r "$directory"; or not test -x "$directory"
    set -l directory_error (printf '%s\n' $directory | string collect)
    if test -z "$directory_error"
        set directory_error "The target directory does not exist or is not accessible: $raw_directory"
    end
    printf 'Run Codex Quick Failed: target directory validation\nError: %s\n' "$directory_error" >&2
    if type -q kdialog
        kdialog --title "Run Codex Quick Failed" --error "$directory_error"
    end
    if $inside
        keep_terminal_open 1
    end
    exit 1
end

if not $inside
    if not type -q ghostty
        printf 'Run Codex Quick Failed: terminal dependency validation\nError: missing dependency: ghostty\n' >&2
        if type -q kdialog
            kdialog --title "Run Codex Quick Failed" --error "Missing dependency: ghostty"
        end
        exit 127
    end
    set -l ghostty_output (ghostty --working-directory="$directory" -e /home/ben/.local/bin/run-quick-codex-task --inside "$directory" 2>&1)
    set -l ghostty_status $status
    if test $ghostty_status -ne 0
        set -l ghostty_error (printf '%s\n' $ghostty_output | string collect)
        if test -z "$ghostty_error"
            set ghostty_error "ghostty exited with status $ghostty_status."
        end
        printf 'Run Codex Quick Failed: opening terminal\nError: %s\n' "$ghostty_error" >&2
        if type -q kdialog
            kdialog --title "Run Codex Quick Failed" --error "$ghostty_error"
        end
        exit $ghostty_status
    end
    exit 0
end

set -g temp_dir ""
set -g preserve_temp_dir false
set -g recovery_directory "$directory"

function cleanup --on-event fish_exit
    if test -n "$temp_dir"; and not $preserve_temp_dir
        set -l cleanup_error (rm -rf -- "$temp_dir" 2>&1)
        set -l cleanup_status $status
        if test $cleanup_status -ne 0
            set -l cleanup_message (printf '%s\n' $cleanup_error | string collect)
            if test -z "$cleanup_message"
                set cleanup_message "rm exited with status $cleanup_status."
            end
            printf '\nRun Codex Quick Failed: temporary workspace cleanup\nError: %s\n' "$cleanup_message" >&2
        else
            set -g temp_dir ""
        end
    end
end

function handle_interrupt --on-signal INT
    set -g preserve_temp_dir true
    printf 'Run Codex Quick interrupted.\nError: received interrupt signal.\n' >&2
    if test -n "$temp_dir"
        printf 'Failure artifacts preserved at: %s\n' "$temp_dir" >&2
    end
    exit 130
end

function fail
    set -g preserve_temp_dir true
    set -l stage "$argv[1]"
    set -l raw_error ""
    if test (count $argv) -gt 1
        set raw_error "$argv[2]"
    end
    if test -z "$raw_error"
        set raw_error "Command exited unsuccessfully."
    end
    printf '\nRun Codex Quick Failed: %s\nError: %s\n' "$stage" "$raw_error" >&2
    if test -n "$temp_dir"
        printf 'Failure artifacts preserved at: %s\n' "$temp_dir" >&2
    end
    set -l failed_session_id ""
    if test -n "$temp_dir"; and test -s "$temp_dir/events.jsonl"
        set -l ids (jq -r 'select(type == "object" and .type == "thread.started" and (.thread_id | type) == "string") | .thread_id' "$temp_dir/events.jsonl" 2>&1)
        set -l ids_status $status
        if test $ids_status -ne 0
            set -l ids_error (printf '%s\n' $ids | string collect)
            if test -z "$ids_error"
                set ids_error "jq exited with status $ids_status."
            end
            printf 'Run Codex Quick Failed: recovery session ID extraction\nError: %s\n' "$ids_error" >&2
        end
        if test $ids_status -eq 0; and test (count $ids) -gt 0; and string match -qr '^[0-9A-Fa-f]{8}(-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}$' -- "$ids[-1]"
            set failed_session_id "$ids[-1]"
        end
    end
    if test -z "$failed_session_id"
        printf 'Run Codex Quick Failed: session recovery\nError: no Codex session is available.\n' >&2
        keep_terminal_open 1
    end
    if test -z "$recovery_directory"; or not test -d "$recovery_directory"; or not test -r "$recovery_directory"; or not test -x "$recovery_directory"
        printf 'Run Codex Quick Failed: resuming Codex session\nError: the validated target directory is unavailable.\n' >&2
        keep_terminal_open 1
    end
    /home/ben/.local/bin/codex resume \
        --model gpt-5.6-luna \
        --config 'model_reasoning_effort="high"' \
        --sandbox workspace-write \
        --cd "$recovery_directory" \
        "$failed_session_id"
    set -l resume_status $status
    if test $resume_status -eq 130
        exit 130
    end
    if test $resume_status -ne 0
        printf 'Run Codex Quick Failed: resuming Codex session\nError: codex exited with status %s.\n' "$resume_status" >&2
        keep_terminal_open $resume_status
    end
    keep_terminal_open 0
end

printf '%s\n\n' "$directory"
set -l usage_json (timeout --kill-after=2s 10s bash -c '
set -u
coproc CODEX_USAGE { exec /home/ben/.local/bin/codex app-server --stdio 2>/dev/null; }
terminate_child() {
    local child="${CODEX_USAGE_PID:-}"
    if [[ -n "$child" ]] && kill -0 "$child" 2>/dev/null; then
        kill -TERM "$child" 2>/dev/null || true
        for _ in {1..20}; do
            if ! kill -0 "$child" 2>/dev/null; then break; fi
            sleep 0.1
        done
        if kill -0 "$child" 2>/dev/null; then kill -KILL "$child" 2>/dev/null || true; fi
    fi
    if [[ -n "$child" ]]; then wait "$child" 2>/dev/null || true; fi
}
trap terminate_child EXIT
trap "exit 124" TERM INT
printf "%s\n" "{\"method\":\"initialize\",\"id\":1,\"params\":{\"clientInfo\":{\"name\":\"run_codex_quick\",\"title\":\"Run Codex Quick\",\"version\":\"1.0.0\"}}}" "{\"method\":\"initialized\"}" "{\"method\":\"account/rateLimits/read\",\"id\":2}" >&"${CODEX_USAGE[1]}"
while IFS= read -r -u "${CODEX_USAGE[0]}" line; do
    if jq -e ".id == 2 and (.result | type == \"object\")" <<<"$line" >/dev/null 2>&1; then
        printf "%s\n" "$line"
        exit 0
    fi
done
exit 1
' | jq -c 'select(type == "object" and (.result | type == "object")) | .result' 2>/dev/null)
set -l usage_pipeline_status $pipestatus

if test "$usage_pipeline_status[1]" -ne 0; or test "$usage_pipeline_status[2]" -ne 0; or test (count $usage_json) -ne 1
    if test "$usage_pipeline_status[1]" -ne 0
        set -l usage_error "rate-limit request exited with status $usage_pipeline_status[1]."
    else if test "$usage_pipeline_status[2]" -ne 0
        set -l usage_error "jq exited with status $usage_pipeline_status[2]."
    else
        set -l usage_error "expected exactly one rate-limit response; received "(count $usage_json)"."
    end
    printf 'Run Codex Quick Failed: usage lookup\nError: %s\n' "$usage_error"
else
    set -l usage_validation (printf '%s\n' "$usage_json" | jq -er '
        def valid_number: type == "number";
        def valid_window:
            type == "object" and
            (.windowDurationMins? | valid_number) and
            (.usedPercent? | valid_number) and
            (.resetsAt? | valid_number);
        (try .rateLimitsByLimitId.codex catch null) as $by_id |
        (if ($by_id | type) == "object" then $by_id else (try .rateLimits catch null) end) as $limit |
        if ($limit | type) != "object" then error("missing rate limit object")
        elif (($limit.primary? // null) != null and (($limit.primary | valid_window) | not)) then error("invalid primary rate limit")
        elif (($limit.secondary? // null) != null and (($limit.secondary | valid_window) | not)) then error("invalid secondary rate limit")
        elif ((.rateLimitResetCredits? // null) != null and ((.rateLimitResetCredits | type) != "object" or (.rateLimitResetCredits.availableCount? | valid_number) | not)) then error("invalid reset credits")
        else "valid"
        end
    ' 2>&1)
    set -l usage_validation_status $status
    if test $usage_validation_status -ne 0
        set -l usage_error (printf '%s\n' $usage_validation | string collect)
        if test -z "$usage_error"
            set usage_error "jq exited with status $usage_validation_status."
        end
        printf 'Run Codex Quick Failed: usage response validation\nError: %s\n' "$usage_error"
    else
        set -l usage_output (printf '%s\n' "$usage_json" | jq -r '
        def duration:
            if . >= 1440 then "\(. / 1440) days"
            elif . >= 60 then "\(. / 60) hours"
            else "\(.) minutes"
            end;
        def window($name; $value):
            if $value == null then empty
            else "\($name) (\($value.windowDurationMins | duration)): \(100 - $value.usedPercent)% remaining; resets \($value.resetsAt | strflocaltime("%a %d %b %H:%M"))"
            end;
        (.rateLimitsByLimitId.codex // .rateLimits) as $limit |
        window("Primary"; $limit.primary),
        window("Secondary"; $limit.secondary),
        if .rateLimitResetCredits == null then empty
        else "Reset credits: \(.rateLimitResetCredits.availableCount)"
        end
        ' 2>&1)
        set -l usage_display_status $pipestatus
        if test "$usage_display_status[1]" -ne 0; or test "$usage_display_status[2]" -ne 0
            set -l usage_error (printf '%s\n' $usage_output | string collect)
            if test -z "$usage_error"
                set usage_error "usage rendering pipeline exited with statuses $usage_display_status."
            end
            printf 'Run Codex Quick Failed: displaying usage\nError: %s\n' "$usage_error"
        else
            printf '%s\n' $usage_output
        end
    end
end
printf '\n'
read -P "Task: " task
set -l task_input_status $status
if test $task_input_status -ne 0
    fail "Task input" "read exited with status $task_input_status."
end
printf '\e]133;C\e\\'
set task (string trim -- "$task")
if test -z "$task"
    fail "Task input" "Task input was empty."
end

set -l state_dir ""(set -q XDG_STATE_HOME; and printf '%s' "$XDG_STATE_HOME"; or printf '%s' "$HOME/.local/state")"/codex-service-menu"
set -l state_dir_error (mkdir -p -- "$state_dir" 2>&1)
set -l state_dir_status $status
if test $state_dir_status -ne 0
    fail "Failure artifact directory creation" (printf '%s\n' $state_dir_error | string collect)
end
set -l temp_dir_result (mktemp -d --tmpdir="$state_dir" quick.XXXXXXXXXX 2>&1)
set -l temp_dir_status $status
if test $temp_dir_status -ne 0; or test (count $temp_dir_result) -ne 1
    set -l temp_dir_error (printf '%s\n' $temp_dir_result | string collect)
    fail "Temporary workspace creation" "$temp_dir_error"
end
set temp_dir "$temp_dir_result"

set -l response_file "$temp_dir/response"
set -l events_file "$temp_dir/events.jsonl"
set -l codex_error_file "$temp_dir/codex.stderr"
set -l tee_error_file "$temp_dir/tee.stderr"
set -l jq_error_file "$temp_dir/jq.stderr"
set -l prompt (printf '%s\n%s\n%s\n%s\n' \
    "Implement the following user task in the target directory with as few changes as required." \
    "Treat the task as authoritative. Do not make unrelated changes." \
    "Return a JSON response matching the supplied schema. The response must be a non-empty user-facing message." \
    "Task: $task" | string collect)

printf 'Implementing...\n\n'
printf '%s\n' "$prompt" | /home/ben/.local/bin/codex exec \
    --model gpt-5.6-luna \
    --config 'model_reasoning_effort="high"' \
    --sandbox workspace-write \
    --cd "$directory" \
    --skip-git-repo-check \
    --json \
    --output-schema /home/ben/.local/bin/codex-task-response-schema.json \
    --output-last-message "$response_file" \
    - 2>"$codex_error_file" | tee "$events_file" 2>"$tee_error_file" | jq -r '
        select(.type == "item.completed") |
        .item |
        if .type == "agent_message" then ((try (.text | fromjson | .response) catch .text) as $message | "\n\($message)\n")
        elif .type == "command_execution" then .command // empty
        else empty
        end
    ' 2>"$jq_error_file"
set -l implementation_statuses $pipestatus
if test "$implementation_statuses[1]" -ne 0
    set -l raw_error (string collect < "$codex_error_file")
    if test -z "$raw_error"
        set raw_error "printf exited with status $implementation_statuses[1]."
    end
    fail "Sending implementation prompt" "$raw_error"
else if test "$implementation_statuses[2]" -ne 0
    set -l raw_error (string collect < "$codex_error_file")
    if test -z "$raw_error"
        set raw_error "codex exited with status $implementation_statuses[2]."
    end
    fail "Implementation" "$raw_error"
else if test "$implementation_statuses[3]" -ne 0
    set -l raw_error (string collect < "$tee_error_file")
    if test -z "$raw_error"
        set raw_error "tee exited with status $implementation_statuses[3]."
    end
    fail "Saving implementation events" "$raw_error"
else if test "$implementation_statuses[4]" -ne 0
    set -l raw_error (string collect < "$jq_error_file")
    if test -z "$raw_error"
        set raw_error "jq exited with status $implementation_statuses[4]."
    end
    fail "Displaying implementation output" "$raw_error"
end

if not test -s "$response_file"
    fail "Implementation response capture" "The implementation response file was empty."
end

set -l response_validation (jq -er '
    if type != "object" then error("response must be a JSON object")
    elif (keys_unsorted | sort) != ["response"] then error("response has unexpected or missing fields")
    elif (.response | type) != "string" then error("response must be a string")
    elif ((.response | test("[^[:space:]]")) | not) then error("response must be non-empty")
    else "valid"
    end
' "$response_file" 2>&1)
set -l response_validation_status $status
if test $response_validation_status -ne 0
    set -l response_error (printf '%s\n' $response_validation | string collect)
    fail "Implementation response validation" "$response_error"
end
set -l completed_response (jq -r '.response' "$response_file" 2>&1)
set -l completed_response_status $status
if test $completed_response_status -ne 0
    set -l response_error (printf '%s\n' $completed_response | string collect)
    if test -z "$response_error"
        set response_error "jq exited with status $completed_response_status."
    end
    fail "Displaying implementation response" "$response_error"
end
printf '\nTask completed  \n%s\n' (printf '%s\n' $completed_response | string collect)

set -l session_ids (jq -r 'select(type == "object" and .type == "thread.started" and (.thread_id | type) == "string") | .thread_id' "$events_file" 2>&1)
set -l session_id_status $status
if test $session_id_status -ne 0
    set -l session_id_error (printf '%s\n' $session_ids | string collect)
    fail "Implementation session ID extraction" "$session_id_error"
end
if test (count $session_ids) -ne 1; or not string match -qr '^[0-9A-Fa-f]{8}(-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}$' -- "$session_ids[1]"
    fail "Implementation session ID extraction" "Expected exactly one valid thread.started session ID."
end
set -l session_id "$session_ids[1]"

set -l cleanup_result (rm -rf -- "$temp_dir" 2>&1)
set -l cleanup_status $status
if test $cleanup_status -ne 0
    set -l cleanup_error (printf '%s\n' $cleanup_result | string collect)
    if test -z "$cleanup_error"
        set cleanup_error "rm exited with status $cleanup_status."
    end
    fail "Removing temporary workspace" "$cleanup_error"
end
set -g temp_dir ""
set -l clear_error (clear 2>&1)
set -l clear_status $status
if test $clear_status -ne 0
    set -l raw_error (printf '%s\n' $clear_error | string collect)
    if test -z "$raw_error"
        set raw_error "clear exited with status $clear_status."
    end
    printf 'Run Codex Quick Failed: clearing terminal\nError: %s\n' "$raw_error" >&2
end
/home/ben/.local/bin/codex resume \
    --model gpt-5.6-luna \
    --config 'model_reasoning_effort="high"' \
    --sandbox workspace-write \
    --cd "$directory" \
    "$session_id"
set -l resume_status $status
if test $resume_status -ne 0
    printf 'Run Codex Quick Failed: resuming Codex session\nError: codex exited with status %s.\n' "$resume_status" >&2
    keep_terminal_open $resume_status
end
exit 0
