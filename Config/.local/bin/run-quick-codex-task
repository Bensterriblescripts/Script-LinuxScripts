#!/usr/bin/env fish

set -l inside false
set -l directory ""

if test (count $argv) -gt 0; and test "$argv[1]" = --inside
    set inside true
    if test (count $argv) -gt 1
        set directory "$argv[2]"
    end
else if test (count $argv) -gt 0
    set directory "$argv[1]"
end

if test -z "$directory"
    kdialog --title "Run Codex Quick Failed" --error "Dolphin target directory  \nError: Dolphin did not provide a target directory. Nothing was opened."
    exit 1
end

if not test -d "$directory"; or not test -r "$directory"; or not test -x "$directory"
    kdialog --title "Run Codex Quick Failed" --error "Target directory validation  \nError: The target directory does not exist or is not accessible:\n$directory"
    exit 1
end

if not $inside
    ghostty --working-directory="$directory" -e /home/ben/.local/bin/run-quick-codex-task --inside "$directory"
    set -l ghostty_status $status
    if test $ghostty_status -ne 0
        printf '\nOpening terminal  \nError: ghostty exited with status %s.\n' "$ghostty_status"
        exit $ghostty_status
    end
    exit 0
end

set -g temp_dir ""

function cleanup --on-event fish_exit
    if test -n "$temp_dir"
        set -l cleanup_error (rm -rf -- "$temp_dir" 2>&1)
        set -l cleanup_status $status
        if test $cleanup_status -ne 0
            printf '\nTemporary workspace cleanup  \nError: %s\n' (string join '\n' -- $cleanup_error) >&2
        end
    end
end

function fail
    set -l failure_status $status
    set -l stage "$argv[1]"
    set -l raw_error "$argv[2]"
    if test -z "$raw_error"
        set raw_error "Command exited with status $failure_status."
    end
    if test -n "$temp_dir"
        set -l cleanup_error (rm -rf -- "$temp_dir" 2>&1)
        set -l cleanup_status $status
        set -g temp_dir ""
        if test $cleanup_status -ne 0
            set raw_error "$raw_error Temporary workspace cleanup failed: (string join '\\n' -- $cleanup_error)"
        end
    end
    printf '\n%s  \nError: %s\n' "$stage" "$raw_error"
    read -P "Press Enter to close."
    exit 1
end

function print_usage
    set -l label "$argv[1]"
    set -l usage_json (timeout 10 bash -c '
        coproc CODEX_USAGE { /home/ben/.local/bin/codex app-server --stdio 2>/dev/null; }
        trap '\''kill "$CODEX_USAGE_PID" 2>/dev/null; wait "$CODEX_USAGE_PID" 2>/dev/null'\'' EXIT
        printf '\''%s\n'\'' \
            '\''{"method":"initialize","id":1,"params":{"clientInfo":{"name":"run_codex_quick","title":"Run Codex Quick","version":"1.0.0"}}}'\'' \
            '\''{"method":"initialized"}'\'' \
            '\''{"method":"account/rateLimits/read","id":2}'\'' >&"${CODEX_USAGE[1]}"
        while IFS= read -r -u "${CODEX_USAGE[0]}" line; do
            if jq -e '\''select(.id == 2 and .result != null)'\'' >/dev/null 2>&1 <<<"$line"; then
                printf '\''%s\n'\'' "$line"
                break
            fi
        done
    ' | jq -c '.result' 2>/dev/null)

    printf '\n=== Codex usage: %s ===\n' "$label"
    if test (count $usage_json) -ne 1
        printf 'Codex usage lookup  \nError: Usage data was unavailable.\n'
        return
    end

    printf '%s\n' "$usage_json" | jq -r '
        def duration:
            if . >= 1440 then "\(. / 1440) days"
            elif . >= 60 then "\(. / 60) hours"
            else "\(.) minutes"
            end;
        def window($name; $value):
            if $value == null then empty
            else "\($name) (\($value.windowDurationMins | duration)): \(100 - $value.usedPercent)% remaining; resets \($value.resetsAt | strflocaltime("%a %d %b %H:%M"))"
            end;
        (.rateLimitsByLimitId.codex // .rateLimits) as $limit |
        "Plan: \($limit.planType // "unknown")",
        window("Primary"; $limit.primary),
        window("Secondary"; $limit.secondary),
        if .rateLimitResetCredits == null then empty
        else "Reset credits: \(.rateLimitResetCredits.availableCount)"
        end
    '
end

print_usage "before"
printf '\n'
read -P "Task: " task
set task (string trim -- "$task")
if test -z "$task"
    fail "Task input"
end

set -l temp_dir_result (mktemp -d 2>&1)
set -l temp_dir_status $status
if test $temp_dir_status -ne 0
    fail "Temporary workspace creation" (string join '\n' -- $temp_dir_result)
end
set temp_dir "$temp_dir_result"

set -l response_file "$temp_dir/response"
set -l events_file "$temp_dir/events.jsonl"
set -l prompt (string join \n \
    "Implement this task with as little changes/additions as required." \
    "Task: $task" | string collect)

printf 'Implementing...\n\n'
printf '%s\n' "$prompt" | /home/ben/.local/bin/codex exec \
    --model gpt-5.6-luna \
    --config 'model_reasoning_effort="high"' \
    --dangerously-bypass-approvals-and-sandbox \
    --skip-git-repo-check \
    --json \
    --output-last-message "$response_file" \
    - | tee "$events_file" | jq -r '
        select(.type == "item.completed") |
        .item |
        if .type == "agent_message" then .text
        elif .type == "command_execution" then .command // empty
        else empty
        end
    '
set -l implementation_statuses $pipestatus
if test "$implementation_statuses[1]" -ne 0
    fail "Sending implementation prompt" "printf exited with status $implementation_statuses[1]."
else if test "$implementation_statuses[2]" -ne 0
    fail "Implementation" "codex exited with status $implementation_statuses[2]."
else if test "$implementation_statuses[3]" -ne 0
    fail "Saving implementation events" "tee exited with status $implementation_statuses[3]."
else if test "$implementation_statuses[4]" -ne 0
    fail "Displaying implementation output" "jq exited with status $implementation_statuses[4]."
end

if not test -s "$response_file"
    fail "Implementation response capture"
end

set -l session_ids (jq -r 'select(.type == "thread.started") | .thread_id // empty' "$events_file")
or fail "Implementation session ID extraction"
if test (count $session_ids) -ne 1; or not string match -qr '^[0-9A-Fa-f]{8}(-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}$' -- "$session_ids[1]"
    fail "Implementation session ID extraction" "Expected exactly one valid session ID."
end
set -l session_id "$session_ids[1]"

rm -rf -- "$temp_dir"
or fail "Removing temporary workspace"
set -g temp_dir ""
clear
/home/ben/.local/bin/codex resume \
    --model gpt-5.6-luna \
    --config 'model_reasoning_effort="high"' \
    --dangerously-bypass-approvals-and-sandbox \
    "$session_id"
set -l resume_status $status
if test $resume_status -ne 0
    printf '\nResuming Codex session  \nError: codex exited with status %s.\n' "$resume_status"
    exit $resume_status
end
