#!/bin/sh

mode=$1
dir=$2

if [ -z "$dir" ]; then
    kdialog --title "Open Here Failed" --error "Dolphin did not provide a target directory. Nothing was opened."
    exit 1
fi

if [ ! -d "$dir" ]; then
    kdialog --title "Open Here Failed" --error "The target directory does not exist or is not accessible:\n$dir"
    exit 1
fi

if ! command -v ghostty >/dev/null 2>&1; then
    kdialog --title "Open Here Failed" --error "Missing dependency: ghostty"
    exit 127
fi

if [ "$mode" = codex ]; then
    if [ ! -x /home/ben/.local/bin/codex ]; then
        kdialog --title "Open Here Failed" --error "/home/ben/.local/bin/codex is not executable."
        exit 127
    fi
    exec ghostty --working-directory="$dir" -e /home/ben/.local/bin/codex
fi

exec ghostty --working-directory="$dir" --gtk-single-instance=false
